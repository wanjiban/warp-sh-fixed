+# ── 以下三个函数为本版新增：修正上游/补丁版在 EL9(RPM) 上的三处硬编码路径与"假成功"问题 ──
+
+# warp-svc 单元真实路径（Debian/Ubuntu 在 /usr/lib/systemd/system，EL9 RPM 在 /etc/systemd/system）
+warp_svc_unit() {
+  local FRAG
+  FRAG="$(systemctl show -p FragmentPath --value warp-svc 2>/dev/null)"
+  [ -n "$FRAG" ] && [ -f "$FRAG" ] && printf '%s' "$FRAG"
+}
+
+# 服务没起就拉起来；不再用 [ -f /usr/lib/... ] 判存在性（该路径在 EL9 上恒不存在 → 该行永不执行）
+warp_svc_start() {
+  [ -n "$(warp_svc_unit)" ] || { warning " warp-svc.service 未找到，cloudflare-warp 可能没装上 "; return 1; }
+  [ "$(systemctl is-active warp-svc 2>/dev/null)" = 'active' ] && return 0
+  systemctl start warp-svc >/dev/null 2>&1
+  sleep 2
+}
+
+# Luban 模式的策略路由持久化。
+# 上游做法是 sed 往 vendor unit 里插 ExecStartPost=warp z / ExecStop=warp x，但有三个坑：
+#   1) 路径写死 /usr/lib/systemd/system/warp-svc.service，EL9 RPM 上该文件不存在（真机验证）；
+#   2) dnf 升级 cloudflare-warp 时 %post 会 cp 覆盖 /etc/systemd/system/warp-svc.service，hook 丢失；
+#   3) 云端客户端自身在网络变化/重连时会 DelRule { tables: [51820] }（N2 journal 实证），规则会被吃掉。
+# 故改为写入独立、幂等的 warp-rules.service（已存在则不覆盖，尊重既有自建单元）。
+luban_rules_unit() {
+  local RULES_SH=/usr/local/bin/warp-rules.sh
+  local RULES_UNIT=/etc/systemd/system/warp-rules.service
+
+  if [ ! -f "$RULES_SH" ]; then
+    cat > "$RULES_SH" <<'EOT'
+#!/bin/bash
+# WARP (Luban / mode warp) 策略路由：add 安装规则，del 清理规则
+IF=CloudflareWARP; IP=172.16.0.2; TBL=51820
+
+if [ "$1" = 'del' ]; then
+  ip -4 rule show | grep -q "from $IP" && ip -4 rule delete from $IP lookup $TBL
+  ip -4 rule show | grep -q "suppress_prefixlength 0" && ip -4 rule delete table main suppress_prefixlength 0
+  ip -6 rule show | grep -q "oif $IF" && ip -6 rule delete oif $IF lookup $TBL
+  ip -6 rule show | grep -q "suppress_prefixlength 0" && ip -6 rule delete table main suppress_prefixlength 0
+  exit 0
+fi
+
+# 开机时接口可能比 warp-svc 服务晚就绪（客户端要连接云端后才建接口），最多等 30s
+for _ in $(seq 1 30); do [ -d "/sys/class/net/$IF" ] && break; sleep 1; done
+[ -d "/sys/class/net/$IF" ] || { echo "$IF 接口未就绪" >&2; exit 1; }
+
+ip route replace default dev $IF table $TBL 2>/dev/null || true
+ip -6 route replace default dev $IF table $TBL 2>/dev/null || true
+ip rule show | grep -q "from $IP lookup $TBL" || ip rule add from $IP lookup $TBL
+ip rule show | grep -q "lookup main suppress_prefixlength 0" || ip rule add table main suppress_prefixlength 0
+ip -6 rule show | grep -q "oif $IF lookup $TBL" || ip -6 rule add oif $IF lookup $TBL
+ip -6 rule show | grep -q "lookup main suppress_prefixlength 0" || ip -6 rule add table main suppress_prefixlength 0
+EOT
+    chmod +x "$RULES_SH"
+  fi
+
+  if [ ! -f "$RULES_UNIT" ]; then
+    cat > "$RULES_UNIT" <<'EOT'
+[Unit]
+Description=WARP (Luban) policy routing rules
+After=warp-svc.service
+Wants=warp-svc.service
+
+[Service]
+Type=oneshot
+RemainAfterExit=yes
+ExecStart=/usr/local/bin/warp-rules.sh add
+ExecStop=/usr/local/bin/warp-rules.sh del
+
+[Install]
+WantedBy=multi-user.target
+EOT
+  fi
+
+  systemctl daemon-reload >/dev/null 2>&1
+  systemctl enable warp-rules.service >/dev/null 2>&1
+  # 接口没就绪时不要拉起（否则会留下 failed 状态）；已就绪则立刻应用一次规则
+  if ip link show CloudflareWARP >/dev/null 2>&1; then
+    systemctl restart warp-rules.service >/dev/null 2>&1 \
+      || warning " warp-rules.service 启动失败，请检查 /usr/local/bin/warp-rules.sh "
+  fi
+}
+
